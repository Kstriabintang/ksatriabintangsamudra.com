---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className = '',
} = Astro.props;

const webpSrc = src.replace(/\.jpe?g$/i, '.webp');
const smallSrc = src.replace(/\.jpe?g$/i, '-small.jpg');
const smallWebpSrc = src.replace(/\.jpe?g$/i, '-small.webp');
const tinySrc = src.replace(/\.jpe?g$/i, '-tiny.jpg');
const tinyWebpSrc = src.replace(/\.jpe?g$/i, '-tiny.webp');
---

<picture style="display:contents">
  <source
    type="image/webp"
    srcset={`${tinyWebpSrc} 342w, ${smallWebpSrc} 480w, ${webpSrc} 1280w`}
    sizes="(max-width: 768px) 100vw, 480px"
  />
  <source
    type="image/jpeg"
    srcset={`${tinySrc} 342w, ${smallSrc} 480w, ${src} 1280w`}
    sizes="(max-width: 768px) 100vw, 480px"
  />
  <img
    src={tinySrc}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    class={className}
  />
</picture>
